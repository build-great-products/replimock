{
  "name": "@roughapp/replimock",
  "version": "15.2.0",
  "description": "Mock Replicache client for testing",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.9.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest",
    "check": "tsc --noEmit",
    "build": "tsup --clean --entry.0 ./src/index.ts --format esm --dts --minify",
    "tidy": "biome check --write",
    "prepublish": "$npm_execpath run build",
    "knip": "knip"
  },
  "keywords": [
    "Replicache",
    "Mock",
    "Testing"
  ],
  "author": {
    "name": "George Czabania"
  },
  "license": "MIT",
  "peerDependencies": {
    "replicache": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@tsconfig/node22": "22.0.5",
    "@types/node": "24.10.2",
    "knip": "5.72.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "dependencies": {
    "tinybase": "7.0.1"
  }
}
