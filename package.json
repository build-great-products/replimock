{
  "name": "@roughapp/replimock",
  "version": "15.0.4",
  "description": "Mock Replicache client for testing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest",
    "check": "tsc --noEmit",
    "build": "tsup --clean --entry.0 ./src/index.ts --format esm --dts --minify",
    "tidy": "biome check --write",
    "prepublish": "$npm_execpath run build"
  },
  "keywords": [
    "Replicache",
    "Mock",
    "Testing"
  ],
  "author": {
    "name": "George Czabania"
  },
  "license": "MIT",
  "peerDependencies": {
    "replicache": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tsconfig/node22": "22.0.0",
    "tsup": "8.4.0",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  },
  "dependencies": {
    "tinybase": "5.4.8"
  }
}
